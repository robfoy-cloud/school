{
  // The app is static files in ./public plus a small Worker (src/worker.js) for the AI endpoints.
  // Access control is enforced by row-level security in Supabase; the Worker acts as the signed-in user.
  // Secret needed: ANTHROPIC_API_KEY (set in the Cloudflare dashboard, never in this file).
  "name": "school",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
